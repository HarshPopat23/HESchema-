{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$dynamicAnchor": "meta",
  "$vocabulary": {
    "https://json-schema.org/draft/2020-12/vocab/core": true,
    "https://json-schema.org/draft/2020-12/vocab/applicator": true,
    "https://json-schema.org/draft/2020-12/vocab/unevaluated": true,
    "https://json-schema.org/draft/2020-12/vocab/validation": true,
    "https://json-schema.org/draft/2020-12/vocab/meta-data": true,
    "https://json-schema.org/draft/2020-12/vocab/format-annotation": true,
    "https://json-schema.org/draft/2020-12/vocab/content": true,
    "https://raw.githubusercontent.com/HarshPopat23/HESchema-/main/vocabulary/field-comparison/v1/README.md": true,
    "https://raw.githubusercontent.com/HarshPopat23/HESchema-/main/vocabulary/keyed-uniqueness/v1/README.md": true,
    "https://raw.githubusercontent.com/HarshPopat23/HESchema-/main/vocabulary/relationships/v2/README.md": true
  },
  "$id": "https://raw.githubusercontent.com/HarshPopat23/HESchema-/main/src/heschema/relationships-v2.json",
  "title": "HESchema Relationships v2 dialect",
  "allOf": [
    {
      "$ref": "https://raw.githubusercontent.com/HarshPopat23/HESchema-/main/src/heschema/relationships-v1.json"
    }
  ],
  "properties": {
    "aggregateCompare": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "left",
          "operator",
          "right"
        ],
        "additionalProperties": false,
        "properties": {
          "left": {
            "$ref": "#/$defs/operand"
          },
          "operator": {
            "$ref": "https://raw.githubusercontent.com/HarshPopat23/HESchema-/main/src/heschema/field-comparison-v1.json#/$defs/comparison/properties/operator"
          },
          "right": {
            "$ref": "#/$defs/operand"
          }
        }
      }
    },
    "localReferences": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "source",
          "target"
        ],
        "additionalProperties": false,
        "properties": {
          "source": {
            "$ref": "#/$defs/keySet"
          },
          "target": {
            "$ref": "#/$defs/keySet"
          }
        }
      }
    }
  },
  "$defs": {
    "operand": {
      "oneOf": [
        {
          "$ref": "https://raw.githubusercontent.com/HarshPopat23/HESchema-/main/src/heschema/field-comparison-v1.json#/$defs/pointer"
        },
        {
          "type": "object",
          "required": [
            "count"
          ],
          "additionalProperties": false,
          "properties": {
            "count": {
              "$ref": "https://raw.githubusercontent.com/HarshPopat23/HESchema-/main/src/heschema/field-comparison-v1.json#/$defs/pointer"
            }
          }
        },
        {
          "type": "object",
          "required": [
            "sum"
          ],
          "additionalProperties": false,
          "properties": {
            "sum": {
              "type": "object",
              "required": [
                "array",
                "item"
              ],
              "additionalProperties": false,
              "properties": {
                "array": {
                  "$ref": "https://raw.githubusercontent.com/HarshPopat23/HESchema-/main/src/heschema/field-comparison-v1.json#/$defs/pointer"
                },
                "item": {
                  "$ref": "https://raw.githubusercontent.com/HarshPopat23/HESchema-/main/src/heschema/field-comparison-v1.json#/$defs/pointer"
                }
              }
            }
          }
        }
      ]
    },
    "keySet": {
      "type": "object",
      "required": [
        "array",
        "keys"
      ],
      "additionalProperties": false,
      "properties": {
        "array": {
          "$ref": "https://raw.githubusercontent.com/HarshPopat23/HESchema-/main/src/heschema/field-comparison-v1.json#/$defs/pointer"
        },
        "keys": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "https://raw.githubusercontent.com/HarshPopat23/HESchema-/main/src/heschema/field-comparison-v1.json#/$defs/pointer"
          }
        }
      }
    }
  }
}
