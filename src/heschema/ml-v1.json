{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/HarshPopat23/HESchema-/main/src/heschema/ml-v1.json",
  "$dynamicAnchor": "meta",
  "$vocabulary": {
    "https://json-schema.org/draft/2020-12/vocab/core": true,
    "https://json-schema.org/draft/2020-12/vocab/applicator": true,
    "https://json-schema.org/draft/2020-12/vocab/unevaluated": true,
    "https://json-schema.org/draft/2020-12/vocab/validation": true,
    "https://json-schema.org/draft/2020-12/vocab/meta-data": true,
    "https://json-schema.org/draft/2020-12/vocab/format-annotation": true,
    "https://json-schema.org/draft/2020-12/vocab/content": true,
    "https://raw.githubusercontent.com/HarshPopat23/HESchema-/main/vocabulary/ml/v1/README.md": true
  },
  "title": "HESchema ML v1 dialect",
  "allOf": [
    {
      "$ref": "https://json-schema.org/draft/2020-12/schema"
    }
  ],
  "properties": {
    "tensorShapes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/tensor"
      }
    }
  },
  "$defs": {
    "tensor": {
      "type": "object",
      "required": [
        "path",
        "shape"
      ],
      "additionalProperties": false,
      "properties": {
        "path": {
          "$ref": "https://raw.githubusercontent.com/HarshPopat23/HESchema-/main/src/heschema/field-comparison-v1.json#/$defs/pointer"
        },
        "shape": {
          "type": "array",
          "items": {
            "oneOf": [
              {
                "type": "integer",
                "minimum": 0
              },
              {
                "type": "string",
                "pattern": "^[A-Za-z_][A-Za-z0-9_]*(?![\\s\\S])"
              },
              {
                "type": "null"
              }
            ]
          }
        }
      }
    }
  }
}
