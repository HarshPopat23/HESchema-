{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/HarshPopat23/HESchema-/main/src/heschema/field-comparison-v1.json",
  "$dynamicAnchor": "meta",
  "$vocabulary": {
    "https://json-schema.org/draft/2020-12/vocab/core": true,
    "https://json-schema.org/draft/2020-12/vocab/applicator": true,
    "https://json-schema.org/draft/2020-12/vocab/unevaluated": true,
    "https://json-schema.org/draft/2020-12/vocab/validation": true,
    "https://json-schema.org/draft/2020-12/vocab/meta-data": true,
    "https://json-schema.org/draft/2020-12/vocab/format-annotation": true,
    "https://json-schema.org/draft/2020-12/vocab/content": true,
    "https://raw.githubusercontent.com/HarshPopat23/HESchema-/main/vocabulary/field-comparison/v1/README.md": true
  },
  "title": "HESchema Field Comparison v1 dialect",
  "allOf": [
    {
      "$ref": "https://json-schema.org/draft/2020-12/schema"
    }
  ],
  "properties": {
    "compareFields": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/comparison"
      }
    }
  },
  "$defs": {
    "comparison": {
      "type": "object",
      "required": [
        "left",
        "right",
        "operator",
        "mode"
      ],
      "additionalProperties": false,
      "properties": {
        "left": {
          "$ref": "#/$defs/pointer"
        },
        "right": {
          "$ref": "#/$defs/pointer"
        },
        "operator": {
          "enum": [
            "eq",
            "ne",
            "lt",
            "lte",
            "gt",
            "gte"
          ]
        },
        "mode": {
          "enum": [
            "json",
            "number",
            "date"
          ]
        }
      },
      "if": {
        "properties": {
          "mode": {
            "const": "json"
          }
        }
      },
      "then": {
        "properties": {
          "operator": {
            "enum": [
              "eq",
              "ne"
            ]
          }
        }
      }
    },
    "pointer": {
      "type": "string",
      "pattern": "^(?:/(?:[^~/]|~[01])*)*(?![\\s\\S])"
    }
  }
}
