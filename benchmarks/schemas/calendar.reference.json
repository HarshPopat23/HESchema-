{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "title": {
      "type": "string",
      "minLength": 1
    },
    "date": {
      "type": "string",
      "format": "date"
    },
    "startTime": {
      "type": "string",
      "pattern": "^([01][0-9]|2[0-3]):[0-5][0-9]$"
    },
    "durationMinutes": {
      "type": "integer",
      "minimum": 5,
      "maximum": 240
    },
    "venue": {
      "type": "string",
      "minLength": 1
    }
  },
  "required": [
    "title",
    "date",
    "startTime",
    "durationMinutes",
    "venue"
  ],
  "additionalProperties": false
}
