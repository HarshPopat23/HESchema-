{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "origin": {
      "type": "string",
      "minLength": 1
    },
    "destination": {
      "type": "string",
      "minLength": 1
    },
    "departureDate": {
      "type": "string",
      "format": "date"
    },
    "travellers": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9
    }
  },
  "required": [
    "origin",
    "destination",
    "departureDate",
    "travellers"
  ],
  "additionalProperties": false
}
