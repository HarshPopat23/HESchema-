{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "recipient": {
      "type": "string",
      "minLength": 1
    },
    "amountMinor": {
      "type": "integer",
      "minimum": 1,
      "maximum": 100000
    },
    "currency": {
      "type": "string",
      "enum": [
        "INR",
        "USD",
        "EUR"
      ]
    },
    "reference": {
      "type": "string",
      "minLength": 1
    }
  },
  "required": [
    "recipient",
    "amountMinor",
    "currency",
    "reference"
  ],
  "additionalProperties": false
}
