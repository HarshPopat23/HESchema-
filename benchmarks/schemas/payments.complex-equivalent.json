{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "amountMinor": {
      "maximum": 100000,
      "minimum": 1,
      "type": "integer"
    },
    "currency": {
      "enum": [
        "INR",
        "USD",
        "EUR"
      ],
      "type": "string"
    },
    "recipient": {
      "minLength": 1,
      "type": "string"
    },
    "reference": {
      "minLength": 1,
      "type": "string"
    }
  },
  "required": [
    "recipient",
    "amountMinor",
    "currency",
    "reference"
  ],
  "type": "object",
  "allOf": [
    {
      "anyOf": [
        {
          "required": [
            "recipient"
          ]
        },
        {
          "not": {
            "required": [
              "recipient"
            ]
          }
        }
      ]
    },
    {
      "anyOf": [
        {
          "required": [
            "amountMinor"
          ]
        },
        {
          "not": {
            "required": [
              "amountMinor"
            ]
          }
        }
      ]
    },
    {
      "anyOf": [
        {
          "required": [
            "currency"
          ]
        },
        {
          "not": {
            "required": [
              "currency"
            ]
          }
        }
      ]
    },
    {
      "anyOf": [
        {
          "required": [
            "reference"
          ]
        },
        {
          "not": {
            "required": [
              "reference"
            ]
          }
        }
      ]
    }
  ]
}
