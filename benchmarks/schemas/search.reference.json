{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "query": {
      "type": "string",
      "minLength": 1
    },
    "maxResults": {
      "type": "integer",
      "minimum": 1,
      "maximum": 10
    },
    "topic": {
      "type": "string",
      "enum": [
        "general",
        "news",
        "finance"
      ]
    }
  },
  "required": [
    "query",
    "maxResults",
    "topic"
  ],
  "additionalProperties": false
}
