{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "sku": {
      "type": "string",
      "minLength": 1
    },
    "warehouse": {
      "type": "string",
      "enum": [
        "DEL",
        "MUM",
        "BLR"
      ]
    },
    "quantity": {
      "type": "integer",
      "minimum": 1,
      "maximum": 50
    },
    "orderId": {
      "type": "string",
      "minLength": 1
    }
  },
  "required": [
    "sku",
    "warehouse",
    "quantity",
    "orderId"
  ],
  "additionalProperties": false
}
