{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "departureDate": {
      "format": "date",
      "type": "string"
    },
    "destination": {
      "minLength": 1,
      "type": "string"
    },
    "origin": {
      "minLength": 1,
      "type": "string"
    },
    "travellers": {
      "maximum": 9,
      "minimum": 1,
      "type": "integer"
    }
  },
  "required": [
    "origin",
    "destination",
    "departureDate",
    "travellers"
  ],
  "type": "object",
  "allOf": [
    {
      "anyOf": [
        {
          "required": [
            "origin"
          ]
        },
        {
          "not": {
            "required": [
              "origin"
            ]
          }
        }
      ]
    },
    {
      "anyOf": [
        {
          "required": [
            "destination"
          ]
        },
        {
          "not": {
            "required": [
              "destination"
            ]
          }
        }
      ]
    },
    {
      "anyOf": [
        {
          "required": [
            "departureDate"
          ]
        },
        {
          "not": {
            "required": [
              "departureDate"
            ]
          }
        }
      ]
    },
    {
      "anyOf": [
        {
          "required": [
            "travellers"
          ]
        },
        {
          "not": {
            "required": [
              "travellers"
            ]
          }
        }
      ]
    }
  ]
}
