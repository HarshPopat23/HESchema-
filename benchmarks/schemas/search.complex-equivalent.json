{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "maxResults": {
      "maximum": 10,
      "minimum": 1,
      "type": "integer"
    },
    "query": {
      "minLength": 1,
      "type": "string"
    },
    "topic": {
      "enum": [
        "general",
        "news",
        "finance"
      ],
      "type": "string"
    }
  },
  "required": [
    "query",
    "maxResults",
    "topic"
  ],
  "type": "object",
  "allOf": [
    {
      "anyOf": [
        {
          "required": [
            "query"
          ]
        },
        {
          "not": {
            "required": [
              "query"
            ]
          }
        }
      ]
    },
    {
      "anyOf": [
        {
          "required": [
            "maxResults"
          ]
        },
        {
          "not": {
            "required": [
              "maxResults"
            ]
          }
        }
      ]
    },
    {
      "anyOf": [
        {
          "required": [
            "topic"
          ]
        },
        {
          "not": {
            "required": [
              "topic"
            ]
          }
        }
      ]
    }
  ]
}
