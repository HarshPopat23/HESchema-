  "components": {
    "schemas": {
      "BenchmarkJobBody": {
        "properties": {
          "domain": {
            "type": "string",
            "title": "Domain"
          },
          "provider": {
            "type": "string",
            "title": "Provider"
          },
          "model": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Model"
          },
          "preset": {
            "type": "string",
            "title": "Preset",
            "default": "quick"
          },
          "caseCount": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Casecount"
          },
          "repeats": {
            "type": "integer",
            "maximum": 5.0,
            "minimum": 1.0,
            "title": "Repeats",
            "default": 1
          },
          "repairs": {
            "type": "integer",
            "maximum": 5.0,
            "minimum": 0.0,
            "title": "Repairs",
            "default": 0
          },
          "interval": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Interval"
          },
          "seed": {
            "type": "integer",
            "title": "Seed",
            "default": 42
          },
          "schema": {
            "anyOf": [
              {
                "additionalProperties": true,
                "type": "object"
              },
              {
                "type": "boolean"
              },
              {
                "type": "null"
              }
            ],
            "title": "Schema"
          },
          "inputPrice": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Inputprice"
          },
          "outputPrice": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Outputprice"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "domain",
          "provider"
        ],
        "title": "BenchmarkJobBody"
      },
      "CliRunBody": {
        "properties": {
          "schema": {
            "additionalProperties": true,
            "type": "object",
            "title": "Schema"
          },
          "prompt": {
            "type": "string",
            "maxLength": 20000,
            "minLength": 1,
            "title": "Prompt"
          },
          "model": {
            "type": "string",
            "minLength": 1,
            "title": "Model"
          },
          "mode": {
            "type": "string",
            "title": "Mode",
            "default": "native_schema"
