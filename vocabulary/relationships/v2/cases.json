[
  {
    "description": "Declared count and item sum",
    "schema": {
      "aggregateCompare": [
        {"left": "/itemCount", "operator": "eq", "right": {"count": "/items"}},
        {"left": "/total", "operator": "eq", "right": {"sum": {"array": "/items", "item": "/minor"}}}
      ]
    },
    "tests": [
      {"description": "Count and signed sum agree", "data": {"itemCount": 2, "items": [{"minor": 7}, {"minor": -2}], "total": 5}, "valid": true},
      {"description": "Count mismatch", "data": {"itemCount": 1, "items": [{"minor": 7}, {"minor": -2}], "total": 5}, "valid": false},
      {"description": "Total mismatch", "data": {"itemCount": 2, "items": [{"minor": 7}, {"minor": -2}], "total": 9}, "valid": false},
      {"description": "Empty collection yields zero", "data": {"itemCount": 0, "items": [], "total": 0}, "valid": true},
      {"description": "Large integers cancel exactly", "data": {"itemCount": 3, "items": [{"minor": 9007199254740992}, {"minor": 1}, {"minor": -9007199254740992}], "total": 1}, "valid": true},
      {"description": "Integral float aliases accepted", "data": {"itemCount": 1.0, "items": [{"minor": 7.0}], "total": 7}, "valid": true},
      {"description": "Boolean rejected", "data": {"itemCount": 1, "items": [{"minor": true}], "total": 1}, "valid": false},
      {"description": "Fraction rejected", "data": {"itemCount": 1, "items": [{"minor": 0.5}], "total": 0}, "valid": false},
      {"description": "Numeric string rejected", "data": {"itemCount": 1, "items": [{"minor": "7"}], "total": 7}, "valid": false},
      {"description": "Missing item field rejected", "data": {"itemCount": 1, "items": [{}], "total": 0}, "valid": false},
      {"description": "Non-array rejected", "data": {"itemCount": 0, "items": {}, "total": 0}, "valid": false}
    ]
  },
  {
    "description": "Compare two array lengths within a nested instance",
    "schema": {
      "properties": {"batch": {"aggregateCompare": [
        {"left": {"count": "/features"}, "operator": "eq", "right": {"count": "/labels"}}
      ]}}
    },
    "tests": [
      {"description": "Aligned cardinality", "data": {"batch": {"features": [[1], [2]], "labels": [0, 1]}}, "valid": true},
      {"description": "Unequal cardinality", "data": {"batch": {"features": [[1], [2]], "labels": [0]}}, "valid": false}
    ]
  },
  {
    "description": "References by ordered compound key",
    "schema": {
      "localReferences": [
        {"source": {"array": "/predictions", "keys": ["/dataset", "/sample"]},
         "target": {"array": "/samples", "keys": ["/dataset", "/id"]}}
      ]
    },
    "tests": [
      {"description": "Repeated source references allowed", "data": {"predictions": [{"dataset": "A", "sample": 1}, {"dataset": "A", "sample": 1}], "samples": [{"dataset": "A", "id": 1.0}, {"dataset": "B", "id": 1}]}, "valid": true},
      {"description": "Partial tuple match fails", "data": {"predictions": [{"dataset": "A", "sample": 1}], "samples": [{"dataset": "B", "id": 1}]}, "valid": false},
      {"description": "Duplicate targets fail with empty source", "data": {"predictions": [], "samples": [{"dataset": "A", "id": 1}, {"dataset": "A", "id": 1.0}]}, "valid": false},
      {"description": "Both arrays empty", "data": {"predictions": [], "samples": []}, "valid": true},
      {"description": "Null matches null", "data": {"predictions": [{"dataset": "A", "sample": null}], "samples": [{"dataset": "A", "id": null}]}, "valid": true},
      {"description": "Missing differs from null", "data": {"predictions": [{"dataset": "A"}], "samples": [{"dataset": "A", "id": null}]}, "valid": false},
      {"description": "Missing target key fails", "data": {"predictions": [], "samples": [{"dataset": "A"}]}, "valid": false},
      {"description": "Missing target array fails", "data": {"predictions": []}, "valid": false},
      {"description": "Booleans differ from numbers", "data": {"predictions": [{"dataset": "A", "sample": true}], "samples": [{"dataset": "A", "id": 1}]}, "valid": false}
    ]
  },
  {
    "description": "Membership in a scalar key array",
    "schema": {
      "localReferences": [
        {"source": {"array": "/citations", "keys": ["/sourceId"]},
         "target": {"array": "/sourceIds", "keys": [""]}}
      ]
    },
    "tests": [
      {"description": "Citation found", "data": {"citations": [{"sourceId": "doc-1"}], "sourceIds": ["doc-1"]}, "valid": true},
      {"description": "Citation is dangling", "data": {"citations": [{"sourceId": "doc-2"}], "sourceIds": ["doc-1"]}, "valid": false}
    ]
  }
]
