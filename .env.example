# Backend only. Copy to .env locally. Never commit actual keys.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GROQ_API_KEY=
MISTRAL_API_KEY=
GEMINI_API_KEY=
OPENROUTER_API_KEY=
HF_TOKEN=
TAVILY_API_KEY=
OLLAMA_BASE_URL=http://localhost:11434
# Set before exposing the API outside localhost.
HESCHEMA_API_TOKEN=
HESCHEMA_DB=data/state.sqlite3
# Optional official Sourcemeta compiler and persistent evaluator worker.
HESCHEMA_ENGINE=jsonschema
JSONSCHEMA_CLI=jsonschema
# Account limits vary; use conservative pacing for free tiers.
HESCHEMA_REQUEST_INTERVAL=3
